# Same main Neon Postgres instance ml-service uses for the food library -
# JDBC format here (note the jdbc: prefix, and username/password are
# separate vars, not inline in the URL).
DATABASE_URL=jdbc:postgresql://<neon-host>/<db>?sslmode=require
DATABASE_USERNAME=
DATABASE_PASSWORD=

# Any long random string - `openssl rand -base64 32`
JWT_SECRET=

# Where ml-service is reachable. Local: http://localhost:8000
# Render: your ml-service's Render URL, e.g. https://mealtracker-ml.onrender.com
ML_SERVICE_URL=http://localhost:8000

# Comma-separated origins allowed to call this API.
# Local: http://localhost:5173
# Prod: your Vercel URL, e.g. https://mealtracker.vercel.app
CORS_ORIGINS=http://localhost:5173

# Render sets PORT automatically - only needed for local docker-compose runs
# where nothing else sets it.
PORT=8080
